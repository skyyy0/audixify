rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all unmatched paths by default
    match /{document=**} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------------------
    // Global Primitives & Verified Identity Helpers
    // ------------------------------------------------------------------------
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser()
        && request.auth.token.email == 'sekay77771@gmail.com';
    }

    // ------------------------------------------------------------------------
    // Entity Validators (Strict Keys, Types, Regex, Bounded Lengths)
    // ------------------------------------------------------------------------
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'username', 'displayName', 'isDeveloper', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'uid',
          'username',
          'displayName',
          'bio',
          'avatarDataUrl',
          'isDeveloper',
          'perfMode',
          'audioQuality',
          'lyricsSize',
          'defaultRegion',
          'autoplay',
          'theme',
          'streakCount',
          'longestStreak',
          'lastCheckInDate',
          'badges',
          'greenBadgeUnlocked',
          'greenBadgeEnabled',
          'goldFrameUnlocked',
          'goldFrameEnabled',
          'recoverableStreak',
          'recoveryUsedTier30',
          'recoveryUsedTier7',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid == userId
        && data.username is string
        && data.username.size() >= 3
        && data.username.size() <= 24
        && data.username.matches('^[a-z0-9_.]{3,24}$')
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 60
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 240))
        && (!('avatarDataUrl' in data) || (data.avatarDataUrl is string && data.avatarDataUrl.size() <= 120000))
        && data.isDeveloper is bool
        && (!data.isDeveloper || isAdmin())
        && (!('perfMode' in data) || (data.perfMode is string && data.perfMode in ['auto', 'lite', 'full']))
        && (!('audioQuality' in data) || (data.audioQuality is string && data.audioQuality in ['auto', 'high', 'saver']))
        && (!('lyricsSize' in data) || (data.lyricsSize is string && data.lyricsSize in ['compact', 'standard', 'large']))
        && (!('defaultRegion' in data) || (data.defaultRegion is string && data.defaultRegion in ['all', 'id', 'asia', 'global']))
        && (!('autoplay' in data) || data.autoplay is bool)
        && (!('theme' in data) || (data.theme is string && data.theme in ['dark', 'light']))
        && (!('streakCount' in data) || (data.streakCount is int && data.streakCount >= 0 && data.streakCount <= 3650))
        && (!('longestStreak' in data) || (data.longestStreak is int && data.longestStreak >= 0 && data.longestStreak <= 3650))
        && (!('lastCheckInDate' in data) || (data.lastCheckInDate is string && data.lastCheckInDate.size() <= 10 && data.lastCheckInDate.matches('^(\\d{4}-\\d{2}-\\d{2})?$')))
        && (!('badges' in data) || (data.badges is list && data.badges.size() <= 25))
        && (!('greenBadgeUnlocked' in data) || data.greenBadgeUnlocked is bool)
        && (!('greenBadgeEnabled' in data) || data.greenBadgeEnabled is bool)
        && (!('goldFrameUnlocked' in data) || data.goldFrameUnlocked is bool)
        && (!('goldFrameEnabled' in data) || data.goldFrameEnabled is bool)
        && (!('recoverableStreak' in data) || (data.recoverableStreak is int && data.recoverableStreak >= 0 && data.recoverableStreak <= 3650))
        && (!('recoveryUsedTier30' in data) || (data.recoveryUsedTier30 is int && data.recoveryUsedTier30 >= 0 && data.recoveryUsedTier30 <= 3))
        && (!('recoveryUsedTier7' in data) || (data.recoveryUsedTier7 is int && data.recoveryUsedTier7 >= 0 && data.recoveryUsedTier7 <= 1))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function hasValidMilestoneRewards(data, prev) {
      return (!data.greenBadgeUnlocked || data.streakCount >= 30 || ('greenBadgeUnlocked' in prev && prev.greenBadgeUnlocked == true))
        && (!data.greenBadgeEnabled || data.greenBadgeUnlocked == true)
        && (!('goldFrameUnlocked' in data) || !data.goldFrameUnlocked || data.streakCount >= 60 || ('goldFrameUnlocked' in prev && prev.goldFrameUnlocked == true))
        && (!('goldFrameEnabled' in data) || !data.goldFrameEnabled || ('goldFrameUnlocked' in data && data.goldFrameUnlocked == true))
        && (!('streak_3' in data.badges) || data.streakCount >= 3 || ('badges' in prev && 'streak_3' in prev.badges))
        && (!('streak_7' in data.badges) || data.streakCount >= 7 || ('badges' in prev && 'streak_7' in prev.badges))
        && (!('streak_30_crown' in data.badges) || data.streakCount >= 30 || ('badges' in prev && 'streak_30_crown' in prev.badges))
        && (!('streak_30_pioneer' in data.badges) || data.streakCount >= 30 || ('badges' in prev && 'streak_30_pioneer' in prev.badges))
        && (!('streak_60_aurora' in data.badges) || data.streakCount >= 60 || ('badges' in prev && 'streak_60_aurora' in prev.badges))
        && (!('streak_60_virtuoso' in data.badges) || data.streakCount >= 60 || ('badges' in prev && 'streak_60_virtuoso' in prev.badges))
        && (!('streak_60_immortal' in data.badges) || data.streakCount >= 60 || ('badges' in prev && 'streak_60_immortal' in prev.badges));
    }

    function isValidStreakCheckIn(data, prev) {
      return ('streakCount' in data)
        && ('longestStreak' in data)
        && ('lastCheckInDate' in data)
        && ('badges' in data)
        && ('greenBadgeUnlocked' in data)
        && ('greenBadgeEnabled' in data)
        && data.lastCheckInDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && (!('lastCheckInDate' in prev) || prev.lastCheckInDate == '' || data.lastCheckInDate > prev.lastCheckInDate)
        && (!('streakCount' in prev) ? data.streakCount <= 1 : (data.streakCount >= 1 && data.streakCount <= prev.streakCount + 1))
        && (!('longestStreak' in prev) ? data.longestStreak >= data.streakCount : (data.longestStreak >= prev.longestStreak && data.longestStreak >= data.streakCount))
        && (
          !('recoverableStreak' in data)
          || data.recoverableStreak == 0
          || (
            ('streakCount' in prev)
            && prev.streakCount >= 7
            && data.streakCount == 1
            && data.recoverableStreak == prev.streakCount
          )
          || (
            ('recoverableStreak' in prev)
            && data.recoverableStreak == prev.recoverableStreak
          )
        )
        && hasValidMilestoneRewards(data, prev);
    }

    function isValidStreakRecovery(data, prev) {
      return ('recoverableStreak' in prev)
        && prev.recoverableStreak is int
        && prev.recoverableStreak >= 7
        && ('recoverableStreak' in data)
        && data.recoverableStreak == 0
        && ('streakCount' in data)
        && data.streakCount == prev.recoverableStreak + 1
        && ('longestStreak' in data)
        && (!('longestStreak' in prev) ? data.longestStreak >= data.streakCount : (data.longestStreak >= prev.longestStreak && data.longestStreak >= data.streakCount))
        && ('badges' in data)
        && ('greenBadgeUnlocked' in data)
        && ('greenBadgeEnabled' in data)
        && (
          prev.recoverableStreak >= 30
            ? (
              ((!('recoveryUsedTier30' in prev)) ? 0 : prev.recoveryUsedTier30) < 3
              && ('recoveryUsedTier30' in data)
              && data.recoveryUsedTier30 == (((!('recoveryUsedTier30' in prev)) ? 0 : prev.recoveryUsedTier30) + 1)
              && ((!('recoveryUsedTier7' in data)) || data.recoveryUsedTier7 == ((!('recoveryUsedTier7' in prev)) ? 0 : prev.recoveryUsedTier7))
            )
            : (
              ((!('recoveryUsedTier7' in prev)) ? 0 : prev.recoveryUsedTier7) < 1
              && ('recoveryUsedTier7' in data)
              && data.recoveryUsedTier7 == (((!('recoveryUsedTier7' in prev)) ? 0 : prev.recoveryUsedTier7) + 1)
              && ((!('recoveryUsedTier30' in data)) || data.recoveryUsedTier30 == ((!('recoveryUsedTier30' in prev)) ? 0 : prev.recoveryUsedTier30))
            )
        )
        && hasValidMilestoneRewards(data, prev);
    }

    function isValidUserLibraryState(data, userId) {
      return data.keys().hasAll(['uid', 'likedTracks', 'followedArtists', 'playlists', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'likedTracks', 'followedArtists', 'playlists', 'updatedAt'])
        && data.uid is string
        && data.uid == userId
        && data.likedTracks is list
        && data.likedTracks.size() <= 100
        && (data.likedTracks.size() == 0 || data.likedTracks[0] is map)
        && data.followedArtists is list
        && data.followedArtists.size() <= 100
        && (data.followedArtists.size() == 0 || data.followedArtists[0] is map)
        && data.playlists is list
        && data.playlists.size() <= 40
        && (data.playlists.size() == 0 || data.playlists[0] is map)
        && data.updatedAt is timestamp;
    }

    function isValidSharedPlaylist(data, playlistId) {
      return data.keys().hasAll([
          'id',
          'name',
          'inviteCode',
          'ownerUid',
          'ownerName',
          'memberUids',
          'members',
          'tracks',
          'updatedByUid',
          'updatedByName',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'name',
          'description',
          'inviteCode',
          'ownerUid',
          'ownerName',
          'memberUids',
          'members',
          'tracks',
          'updatedByUid',
          'updatedByName',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string
        && data.id == playlistId
        && data.id.size() >= 6
        && data.id.size() <= 32
        && data.inviteCode is string
        && data.inviteCode == playlistId
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 60
        && (!('description' in data) || (data.description is string && data.description.size() <= 180))
        && data.ownerUid is string
        && data.ownerUid.size() >= 1
        && data.ownerUid.size() <= 128
        && data.ownerName is string
        && data.ownerName.size() >= 1
        && data.ownerName.size() <= 60
        && data.memberUids is list
        && data.memberUids.size() >= 1
        && data.memberUids.size() <= 25
        && data.ownerUid in data.memberUids
        && data.members is list
        && data.members.size() >= 1
        && data.members.size() <= 25
        && data.members.size() == data.memberUids.size()
        && data.members[0] is map
        && data.tracks is list
        && data.tracks.size() <= 100
        && (data.tracks.size() == 0 || data.tracks[0] is map)
        && data.updatedByUid is string
        && data.updatedByUid.size() >= 1
        && data.updatedByUid.size() <= 128
        && data.updatedByName is string
        && data.updatedByName.size() >= 1
        && data.updatedByName.size() <= 60
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidListenRoom(data, roomId) {
      return data.keys().hasAll([
          'id',
          'code',
          'name',
          'hostUid',
          'hostName',
          'maxMembers',
          'memberUids',
          'members',
          'currentTrack',
          'isPlaying',
          'positionSec',
          'syncUpdatedAtMs',
          'updatedByUid',
          'updatedByName',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'code',
          'name',
          'hostUid',
          'hostName',
          'maxMembers',
          'memberUids',
          'members',
          'currentTrack',
          'isPlaying',
          'positionSec',
          'syncUpdatedAtMs',
          'updatedByUid',
          'updatedByName',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string
        && data.id == roomId
        && data.id.size() >= 6
        && data.id.size() <= 24
        && data.code is string
        && data.code == roomId
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 60
        && data.hostUid is string
        && data.hostUid.size() >= 1
        && data.hostUid.size() <= 128
        && data.hostName is string
        && data.hostName.size() >= 1
        && data.hostName.size() <= 60
        && data.maxMembers is int
        && data.maxMembers >= 2
        && data.maxMembers <= 10
        && data.memberUids is list
        && data.memberUids.size() >= 1
        && data.memberUids.size() <= data.maxMembers
        && data.hostUid in data.memberUids
        && data.members is list
        && data.members.size() == data.memberUids.size()
        && data.members[0] is map
        && (data.currentTrack == null || data.currentTrack is map)
        && data.isPlaying is bool
        && (data.positionSec is int || data.positionSec is float)
        && data.positionSec >= 0
        && data.positionSec <= 36000
        && data.syncUpdatedAtMs is int
        && data.syncUpdatedAtMs >= 0
        && data.updatedByUid is string
        && data.updatedByUid.size() >= 1
        && data.updatedByUid.size() <= 128
        && data.updatedByName is string
        && data.updatedByName.size() >= 1
        && data.updatedByName.size() <= 60
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidListenRoomMessage(data, roomId) {
      return data.keys().hasAll([
          'roomId',
          'senderUid',
          'senderName',
          'text',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'roomId',
          'senderUid',
          'senderName',
          'senderUsername',
          'senderAvatar',
          'isDeveloper',
          'greenBadge',
          'goldFrame',
          'text',
          'createdAt'
        ])
        && data.roomId is string
        && data.roomId == roomId
        && data.senderUid is string
        && data.senderUid == request.auth.uid
        && data.senderName is string
        && data.senderName.size() >= 1
        && data.senderName.size() <= 60
        && (!('senderUsername' in data) || (data.senderUsername is string && data.senderUsername.size() <= 24))
        && (!('senderAvatar' in data) || (data.senderAvatar is string && data.senderAvatar.size() <= 120000))
        && (!('isDeveloper' in data) || (data.isDeveloper is bool && (!data.isDeveloper || isAdmin())))
        && (!('greenBadge' in data) || data.greenBadge is bool)
        && (!('goldFrame' in data) || data.goldFrame is bool)
        && data.text is string
        && data.text.size() >= 1
        && data.text.size() <= 500
        && data.createdAt is timestamp;
    }

    function isValidSupportThread(data, threadId) {
      return data.keys().hasAll([
          'ownerUid',
          'senderName',
          'category',
          'status',
          'unreadByAdmin',
          'unreadByUser',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid',
          'senderName',
          'senderUsername',
          'senderAvatar',
          'category',
          'status',
          'lastMessagePreview',
          'unreadByAdmin',
          'unreadByUser',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerUid is string
        && data.ownerUid == threadId
        && data.senderName is string
        && data.senderName.size() >= 1
        && data.senderName.size() <= 60
        && (!('senderUsername' in data) || (data.senderUsername is string && data.senderUsername.size() <= 24))
        && (!('senderAvatar' in data) || (data.senderAvatar is string && data.senderAvatar.size() <= 120000))
        && data.category is string
        && data.category in ['bug', 'stream', 'feature', 'general']
        && data.status is string
        && data.status in ['open', 'resolved']
        && (!('lastMessagePreview' in data) || (data.lastMessagePreview is string && data.lastMessagePreview.size() <= 200))
        && data.unreadByAdmin is bool
        && data.unreadByUser is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSupportMessage(data, threadId) {
      return data.keys().hasAll(['threadOwnerUid', 'senderUid', 'senderName', 'senderRole', 'text', 'createdAt'])
        && data.keys().hasOnly([
          'threadOwnerUid',
          'senderUid',
          'senderName',
          'senderUsername',
          'senderAvatar',
          'senderRole',
          'text',
          'imageDataUrl',
          'deviceInfo',
          'createdAt'
        ])
        && data.threadOwnerUid is string
        && data.threadOwnerUid == threadId
        && data.senderUid is string
        && data.senderUid == request.auth.uid
        && data.senderName is string
        && data.senderName.size() >= 1
        && data.senderName.size() <= 60
        && (!('senderUsername' in data) || (data.senderUsername is string && data.senderUsername.size() <= 24))
        && (!('senderAvatar' in data) || (data.senderAvatar is string && data.senderAvatar.size() <= 120000))
        && data.senderRole is string
        && data.senderRole in ['user', 'developer']
        && (data.senderRole != 'developer' || isAdmin())
        && data.text is string
        && data.text.size() <= 1500
        && (!('imageDataUrl' in data) || (data.imageDataUrl is string && data.imageDataUrl.size() <= 420000))
        && (!('deviceInfo' in data) || (data.deviceInfo is string && data.deviceInfo.size() <= 220))
        && (data.text.size() > 0 || ('imageDataUrl' in data && data.imageDataUrl.size() > 0))
        && data.createdAt is timestamp;
    }

    // ------------------------------------------------------------------------
    // Collection Rules
    // ------------------------------------------------------------------------
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && (!('streakCount' in incoming()) || incoming().streakCount <= 1)
        && (!('longestStreak' in incoming()) || incoming().longestStreak <= 1)
        && (!('badges' in incoming()) || incoming().badges.size() == 0)
        && (!('greenBadgeUnlocked' in incoming()) || incoming().greenBadgeUnlocked == false)
        && (!('greenBadgeEnabled' in incoming()) || incoming().greenBadgeEnabled == false)
        && (!('goldFrameUnlocked' in incoming()) || incoming().goldFrameUnlocked == false)
        && (!('goldFrameEnabled' in incoming()) || incoming().goldFrameEnabled == false)
        && (!('recoverableStreak' in incoming()) || incoming().recoverableStreak == 0)
        && (!('recoveryUsedTier30' in incoming()) || incoming().recoveryUsedTier30 == 0)
        && (!('recoveryUsedTier7' in incoming()) || incoming().recoveryUsedTier7 == 0)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && (isOwner(userId) || isAdmin())
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            incoming().isDeveloper == existing().isDeveloper
            && (
              // Action 1: Profile & preferences edit
              incoming().diff(existing()).affectedKeys().hasOnly([
                'username',
                'displayName',
                'bio',
                'avatarDataUrl',
                'perfMode',
                'audioQuality',
                'lyricsSize',
                'defaultRegion',
                'autoplay',
                'theme',
                'updatedAt'
              ])
              // Action 2: Daily check-in streak progression
              || (
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'streakCount',
                  'longestStreak',
                  'lastCheckInDate',
                  'badges',
                  'greenBadgeUnlocked',
                  'greenBadgeEnabled',
                  'goldFrameUnlocked',
                  'goldFrameEnabled',
                  'recoverableStreak',
                  'updatedAt'
                ])
                && isValidStreakCheckIn(incoming(), existing())
              )
              // Action 3: Toggle green verified checkmark once unlocked
              || (
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'greenBadgeEnabled',
                  'updatedAt'
                ])
                && ('greenBadgeUnlocked' in existing() && existing().greenBadgeUnlocked == true)
              )
              // Action 4: Toggle 60-day Gold Sovereign frame once unlocked
              || (
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'goldFrameEnabled',
                  'updatedAt'
                ])
                && ('goldFrameUnlocked' in existing() && existing().goldFrameUnlocked == true)
              )
              // Action 5: Streak Recovery (max 3x for >=30d, max 1x for >=7d)
              || (
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'streakCount',
                  'longestStreak',
                  'badges',
                  'greenBadgeUnlocked',
                  'greenBadgeEnabled',
                  'goldFrameUnlocked',
                  'goldFrameEnabled',
                  'recoverableStreak',
                  'recoveryUsedTier30',
                  'recoveryUsedTier7',
                  'updatedAt'
                ])
                && isValidStreakRecovery(incoming(), existing())
              )
            )
          )
        );

      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    match /userLibraries/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserLibraryState(incoming(), userId)
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserLibraryState(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'likedTracks',
          'followedArtists',
          'playlists',
          'updatedAt'
        ]);

      allow delete: if isValidId(userId) && isOwner(userId);
    }

    match /sharedPlaylists/{playlistId} {
      allow get: if isValidId(playlistId) && isVerifiedUser();
      allow list: if isVerifiedUser() && request.auth.uid in resource.data.memberUids;

      allow create: if isValidId(playlistId)
        && isVerifiedUser()
        && isValidSharedPlaylist(incoming(), playlistId)
        && incoming().ownerUid == request.auth.uid
        && incoming().updatedByUid == request.auth.uid
        && request.auth.uid in incoming().memberUids
        && incoming().memberUids.size() == 1
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(playlistId)
        && isVerifiedUser()
        && isValidSharedPlaylist(incoming(), playlistId)
        && incoming().id == existing().id
        && incoming().inviteCode == existing().inviteCode
        && incoming().ownerUid == existing().ownerUid
        && incoming().ownerName == existing().ownerName
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().updatedByUid == request.auth.uid
        && (
          isAdmin()
          // Action 1: Member updates tracks, title, or description
          || (
            request.auth.uid in existing().memberUids
            && incoming().memberUids == existing().memberUids
            && incoming().members == existing().members
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'name',
              'description',
              'tracks',
              'updatedByUid',
              'updatedByName',
              'updatedAt'
            ])
          )
          // Action 2: User joins playlist via invite code
          || (
            !(request.auth.uid in existing().memberUids)
            && existing().memberUids.size() < 25
            && request.auth.uid in incoming().memberUids
            && incoming().memberUids.hasAll(existing().memberUids)
            && incoming().memberUids.size() == existing().memberUids.size() + 1
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'memberUids',
              'members',
              'updatedByUid',
              'updatedByName',
              'updatedAt'
            ])
          )
          // Action 3: Non-owner member leaves playlist
          || (
            request.auth.uid in existing().memberUids
            && request.auth.uid != existing().ownerUid
            && !(request.auth.uid in incoming().memberUids)
            && existing().memberUids.hasAll(incoming().memberUids)
            && incoming().memberUids.size() == existing().memberUids.size() - 1
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'memberUids',
              'members',
              'updatedByUid',
              'updatedByName',
              'updatedAt'
            ])
          )
        );

      allow delete: if isValidId(playlistId)
        && isVerifiedUser()
        && (existing().ownerUid == request.auth.uid || isAdmin());
    }

    match /listenRooms/{roomId} {
      allow get: if isValidId(roomId) && isVerifiedUser();
      allow list: if isVerifiedUser() && request.auth.uid in resource.data.memberUids;

      allow create: if isValidId(roomId)
        && isVerifiedUser()
        && isValidListenRoom(incoming(), roomId)
        && incoming().hostUid == request.auth.uid
        && incoming().updatedByUid == request.auth.uid
        && request.auth.uid in incoming().memberUids
        && incoming().memberUids.size() == 1
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(roomId)
        && isVerifiedUser()
        && isValidListenRoom(incoming(), roomId)
        && incoming().id == existing().id
        && incoming().code == existing().code
        && incoming().hostUid == existing().hostUid
        && incoming().hostName == existing().hostName
        && incoming().maxMembers == existing().maxMembers
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().updatedByUid == request.auth.uid
        && (
          isAdmin()
          // Action 1: Existing member updates track / play state / seek / room name
          || (
            request.auth.uid in existing().memberUids
            && incoming().memberUids == existing().memberUids
            && incoming().members == existing().members
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'name',
              'currentTrack',
              'isPlaying',
              'positionSec',
              'syncUpdatedAtMs',
              'updatedByUid',
              'updatedByName',
              'updatedAt'
            ])
          )
          // Action 2: Join room up to host maxMembers capacity
          || (
            !(request.auth.uid in existing().memberUids)
            && existing().memberUids.size() < existing().maxMembers
            && request.auth.uid in incoming().memberUids
            && incoming().memberUids.hasAll(existing().memberUids)
            && incoming().memberUids.size() == existing().memberUids.size() + 1
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'memberUids',
              'members',
              'updatedByUid',
              'updatedByName',
              'updatedAt'
            ])
          )
          // Action 3: Non-host member leaves room
          || (
            request.auth.uid in existing().memberUids
            && request.auth.uid != existing().hostUid
            && !(request.auth.uid in incoming().memberUids)
            && existing().memberUids.hasAll(incoming().memberUids)
            && incoming().memberUids.size() == existing().memberUids.size() - 1
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'memberUids',
              'members',
              'updatedByUid',
              'updatedByName',
              'updatedAt'
            ])
          )
        );

      allow delete: if isValidId(roomId)
        && isVerifiedUser()
        && (existing().hostUid == request.auth.uid || isAdmin());

      match /messages/{messageId} {
        allow get: if isValidId(roomId)
          && isValidId(messageId)
          && isVerifiedUser()
          && (
            isAdmin()
            || request.auth.uid in get(/databases/$(database)/documents/listenRooms/$(roomId)).data.memberUids
          );

        allow list: if isValidId(roomId)
          && isVerifiedUser()
          && (
            isAdmin()
            || request.auth.uid in get(/databases/$(database)/documents/listenRooms/$(roomId)).data.memberUids
          );

        allow create: if isValidId(roomId)
          && isValidId(messageId)
          && isVerifiedUser()
          && isValidListenRoomMessage(incoming(), roomId)
          && incoming().createdAt == request.time
          && existsAfter(/databases/$(database)/documents/listenRooms/$(roomId))
          && request.auth.uid in getAfter(/databases/$(database)/documents/listenRooms/$(roomId)).data.memberUids;

        allow update, delete: if false;
      }
    }

    match /supportThreads/{threadId} {
      allow get: if isValidId(threadId) && (isAdmin() || isOwner(threadId));
      allow list: if isAdmin() || (isVerifiedUser() && resource.data.ownerUid == request.auth.uid);

      allow create: if isValidId(threadId)
        && isOwner(threadId)
        && isValidSupportThread(incoming(), threadId)
        && incoming().status == 'open'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(threadId)
        && isValidSupportThread(incoming(), threadId)
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            isOwner(threadId)
            && existing().status != 'resolved'
            && incoming().status == existing().status
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'senderName',
              'senderUsername',
              'senderAvatar',
              'category',
              'lastMessagePreview',
              'unreadByAdmin',
              'unreadByUser',
              'updatedAt'
            ])
          )
        );

      allow delete: if isValidId(threadId) && isAdmin();

      match /messages/{messageId} {
        allow get: if isValidId(threadId)
          && isValidId(messageId)
          && (
            isAdmin()
            || isOwner(threadId)
          );

        allow list: if isValidId(threadId)
          && (
            isAdmin()
            || isOwner(threadId)
          );

        allow create: if isValidId(threadId)
          && isValidId(messageId)
          && isVerifiedUser()
          && isValidSupportMessage(incoming(), threadId)
          && incoming().createdAt == request.time
          && existsAfter(/databases/$(database)/documents/supportThreads/$(threadId))
          && (
            isAdmin()
            || (
              getAfter(/databases/$(database)/documents/supportThreads/$(threadId)).data.ownerUid == request.auth.uid
              && getAfter(/databases/$(database)/documents/supportThreads/$(threadId)).data.status != 'resolved'
            )
          );

        allow update, delete: if false;
      }
    }
  }
}
