{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Audixify user profile, customizable handle, avatar, daily streak, collectible badges, and persisted playback settings.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Authentication UID matching the document ID."
        },
        "email": {
          "type": "string",
          "minLength": 0,
          "maxLength": 160,
          "description": "Verified Google account email visible only to account owner and developer admin."
        },
        "authProvider": {
          "type": "string",
          "enum": ["google", "other"],
          "description": "Authentication provider used for registration."
        },
        "role": {
          "type": "string",
          "enum": ["listener", "vip", "moderator", "developer"],
          "description": "Community and access role managed by developer admin."
        },
        "username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 24,
          "pattern": "^[a-z0-9_.]{3,24}$",
          "description": "Unique-style handle shown in Audixify profile and support chat."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "User display name."
        },
        "bio": {
          "type": "string",
          "minLength": 0,
          "maxLength": 240,
          "description": "Short user bio or music mood."
        },
        "avatarDataUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120000,
          "description": "Google avatar URL or compressed 256px JPEG data URL."
        },
        "isDeveloper": {
          "type": "boolean",
          "description": "Developer privilege flag managed strictly by verified developer admin."
        },
        "perfMode": {
          "type": "string",
          "enum": ["auto", "lite", "full"],
          "description": "GPU and Liquid Glass performance tier."
        },
        "audioQuality": {
          "type": "string",
          "enum": ["auto", "high", "saver"],
          "description": "Preferred audio playback quality tier."
        },
        "lyricsSize": {
          "type": "string",
          "enum": ["compact", "standard", "large"],
          "description": "Now Playing lyrics font scale."
        },
        "defaultRegion": {
          "type": "string",
          "enum": ["all", "id", "asia", "global"],
          "description": "Default catalog region filter."
        },
        "autoplay": {
          "type": "boolean",
          "description": "Continue playing queue automatically."
        },
        "theme": {
          "type": "string",
          "enum": ["dark", "light"],
          "description": "Studio Light or Obsidian Dark theme preference."
        },
        "streakCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3650,
          "description": "Consecutive daily check-in streak count."
        },
        "longestStreak": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3650,
          "description": "All-time longest daily check-in streak."
        },
        "lastCheckInDate": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10,
          "description": "YYYY-MM-DD of the most recent daily streak check-in."
        },
        "badges": {
          "type": "array",
          "description": "Unlocked collectible badge IDs (max 25)."
        },
        "greenBadgeUnlocked": {
          "type": "boolean",
          "description": "Unlocked upon reaching a 30-day consecutive login streak."
        },
        "greenBadgeEnabled": {
          "type": "boolean",
          "description": "User preference to display or hide their unlocked green verified checkmark."
        },
        "goldFrameUnlocked": {
          "type": "boolean",
          "description": "Unlocked upon reaching a 60-day consecutive login streak."
        },
        "goldFrameEnabled": {
          "type": "boolean",
          "description": "User preference to display or hide their unlocked Gold Sovereign frame."
        },
        "recoverableStreak": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3650,
          "description": "Previous streak >= 7 available for one-time or three-time recovery after a missed check-in."
        },
        "recoveryUsedTier30": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "description": "Number of streak recoveries used for streaks >= 30 days (max 3)."
        },
        "recoveryUsedTier7": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1,
          "description": "Number of streak recoveries used for streaks 7-29 days (max 1)."
        },
        "lastSeenAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of most recent active session."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of account creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last profile update."
        }
      },
      "required": ["uid", "username", "displayName", "isDeveloper", "createdAt", "updatedAt"]
    },
    "UserLibraryState": {
      "title": "UserLibraryState",
      "description": "Cloud-synced liked songs, followed artists, and custom playlists per user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "likedTracks": {
          "type": "array",
          "description": "Bounded array of liked tracks (max 100)."
        },
        "followedArtists": {
          "type": "array",
          "description": "Bounded array of followed artists (max 100)."
        },
        "playlists": {
          "type": "array",
          "description": "Bounded array of user playlists (max 40)."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "likedTracks", "followedArtists", "playlists", "updatedAt"]
    },
    "SharedPlaylist": {
      "title": "SharedPlaylist",
      "description": "Real-time collaborative playlist shared among Audixify users via invite code.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 6,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 180
        },
        "inviteCode": {
          "type": "string",
          "minLength": 6,
          "maxLength": 32
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "ownerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "memberUids": {
          "type": "array",
          "description": "UIDs of collaborators (max 25)."
        },
        "members": {
          "type": "array",
          "description": "Public display summaries of collaborators (max 25)."
        },
        "tracks": {
          "type": "array",
          "description": "Shared tracklist (max 100 tracks)."
        },
        "updatedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "updatedByName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "inviteCode",
        "ownerUid",
        "ownerName",
        "memberUids",
        "members",
        "tracks",
        "updatedByUid",
        "updatedByName",
        "createdAt",
        "updatedAt"
      ]
    },
    "SupportThread": {
      "title": "SupportThread",
      "description": "User bug report & support chat thread with Audixify developer sky.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "senderUsername": {
          "type": "string",
          "minLength": 0,
          "maxLength": 24
        },
        "senderAvatar": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120000
        },
        "category": {
          "type": "string",
          "enum": ["bug", "stream", "feature", "general"]
        },
        "status": {
          "type": "string",
          "enum": ["open", "resolved"]
        },
        "lastMessagePreview": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200
        },
        "unreadByAdmin": {
          "type": "boolean"
        },
        "unreadByUser": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerUid",
        "senderName",
        "category",
        "status",
        "unreadByAdmin",
        "unreadByUser",
        "createdAt",
        "updatedAt"
      ]
    },
    "SupportMessage": {
      "title": "SupportMessage",
      "description": "Message inside a support chat thread, optionally carrying a compressed bug-evidence photo.",
      "type": "object",
      "properties": {
        "threadOwnerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "senderUsername": {
          "type": "string",
          "minLength": 0,
          "maxLength": 24
        },
        "senderAvatar": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120000
        },
        "senderRole": {
          "type": "string",
          "enum": ["user", "developer"]
        },
        "text": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1500
        },
        "imageDataUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 420000
        },
        "deviceInfo": {
          "type": "string",
          "minLength": 0,
          "maxLength": 220
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["threadOwnerUid", "senderUid", "senderName", "senderRole", "text", "createdAt"]
    },
    "ListenRoom": {
      "title": "ListenRoom",
      "description": "Real-time Listen Together room with participant limit, synchronized playback, and in-room track picking.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 6,
          "maxLength": 24,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "code": {
          "type": "string",
          "minLength": 6,
          "maxLength": 24
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "hostUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "hostName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "maxMembers": {
          "type": "integer",
          "minimum": 2,
          "maximum": 10
        },
        "memberUids": {
          "type": "array",
          "description": "UIDs of active listeners inside the room (max 10)."
        },
        "members": {
          "type": "array",
          "description": "Public display summaries of active listeners (max 10)."
        },
        "currentTrack": {
          "type": "object",
          "description": "Currently active synchronized track or null."
        },
        "isPlaying": {
          "type": "boolean"
        },
        "positionSec": {
          "type": "number",
          "minimum": 0
        },
        "syncUpdatedAtMs": {
          "type": "integer",
          "minimum": 0
        },
        "updatedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "updatedByName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "code",
        "name",
        "hostUid",
        "hostName",
        "maxMembers",
        "memberUids",
        "members",
        "isPlaying",
        "positionSec",
        "syncUpdatedAtMs",
        "updatedByUid",
        "updatedByName",
        "createdAt",
        "updatedAt"
      ]
    },
    "ListenRoomMessage": {
      "title": "ListenRoomMessage",
      "description": "Real-time chat message sent inside a Listen Together room.",
      "type": "object",
      "properties": {
        "roomId": {
          "type": "string",
          "minLength": 6,
          "maxLength": 24,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "senderUsername": {
          "type": "string",
          "minLength": 0,
          "maxLength": 24
        },
        "senderAvatar": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120000
        },
        "isDeveloper": {
          "type": "boolean"
        },
        "greenBadge": {
          "type": "boolean"
        },
        "goldFrame": {
          "type": "boolean"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["roomId", "senderUid", "senderName", "text", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Authenticated user profile, streak badges, and app preferences."
    },
    "/userLibraries/{userId}": {
      "schema": { "$ref": "#/entities/UserLibraryState" },
      "description": "User synced likes, followed artists, and playlists."
    },
    "/sharedPlaylists/{playlistId}": {
      "schema": { "$ref": "#/entities/SharedPlaylist" },
      "description": "Collaborative real-time playlists shared via invite code."
    },
    "/listenRooms/{roomId}": {
      "schema": { "$ref": "#/entities/ListenRoom" },
      "description": "Real-time Listen Together rooms with participant capacity limits and synced playback."
    },
    "/listenRooms/{roomId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ListenRoomMessage" },
      "description": "Live chat messages inside a Listen Together room."
    },
    "/supportThreads/{threadId}": {
      "schema": { "$ref": "#/entities/SupportThread" },
      "description": "Support & bug report conversations between users and developer sky."
    },
    "/supportThreads/{threadId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/SupportMessage" },
      "description": "Individual messages and photo bug evidence inside a support thread."
    }
  }
}
